{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "tsc && vite build",
        "dev": "vite",
        "lint": "eslint resources/js --ext .js,.jsx,.ts,.tsx --ignore-path .gitignore --fix",
        "types:check": "tsc --noEmit",
        "test": "vitest run",
        "test:watch": "vitest",
        "emails:build": "tsx scripts/build-emails.ts",
        "emails:dev": "email dev --dir resources/js/emails",
        "preflight": "node scripts/preflight.mjs",
        "preflight:push": "node scripts/preflight.mjs --push",
        "preflight:all": "node scripts/preflight.mjs --all"
    },
    "devDependencies": {
        "@headlessui/react": "^2.0.0",
        "@inertiajs/react": "^2.0.0",
        "@react-email/components": "^1.0.12",
        "@react-email/render": "^2.1.0",
        "@tailwindcss/container-queries": "^0.1.1",
        "@tailwindcss/forms": "^0.5.3",
        "@tailwindcss/vite": "^4.0.0",
        "@testing-library/dom": "^10.4.1",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.3",
        "@types/node": "^22.12.0",
        "@types/react": "^18.0.28",
        "@types/react-dom": "^18.0.10",
        "@typescript-eslint/eslint-plugin": "^7.16.0",
        "@typescript-eslint/parser": "^7.16.0",
        "@vitejs/plugin-react": "^4.2.0",
        "autoprefixer": "^10.4.12",
        "axios": "^1.11.0",
        "concurrently": "^9.0.1",
        "eslint": "^8.57.0",
        "eslint-config-prettier": "^9.1.0",
        "eslint-plugin-prettier": "^5.1.3",
        "eslint-plugin-react": "^7.34.4",
        "eslint-plugin-react-hooks": "^4.6.2",
        "jsdom": "^29.1.1",
        "laravel-vite-plugin": "^2.0.0",
        "postcss": "^8.4.31",
        "prettier": "^3.3.0",
        "prettier-plugin-organize-imports": "^4.0.0",
        "prettier-plugin-tailwindcss": "^0.6.5",
        "react": "^18.2.0",
        "react-dom": "^18.2.0",
        "react-email": "^6.9.5",
        "tailwindcss": "^3.2.1",
        "tailwindcss-animate": "^1.0.7",
        "tsx": "^4.23.13",
        "typescript": "^5.0.2",
        "vite": "^7.0.7",
        "vitest": "^5.0.0"
    },
    "dependencies": {
        "@base-ui/react": "^1.8.0",
        "@radix-ui/react-avatar": "^1.1.11",
        "@radix-ui/react-checkbox": "^1.3.3",
        "@radix-ui/react-dropdown-menu": "^2.1.16",
        "@radix-ui/react-select": "^2.2.6",
        "@radix-ui/react-separator": "^1.1.8",
        "@radix-ui/react-slot": "^1.2.4",
        "@radix-ui/react-switch": "^1.2.6",
        "@tiptap/extension-image": "^3.20.4",
        "@tiptap/extension-link": "^3.20.4",
        "@tiptap/extension-underline": "^3.20.4",
        "@tiptap/extension-youtube": "^3.20.4",
        "@tiptap/react": "^3.20.4",
        "@tiptap/starter-kit": "^3.20.4",
        "@types/dompurify": "^3.0.5",
