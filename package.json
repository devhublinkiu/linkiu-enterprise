        "input-otp": "^1.5.0",
        "laravel-echo": "^2.3.1",
        "lucide-react": "^0.577.0",
        "pusher-js": "^8.4.2",
        "radix-ui": "^1.6.7",
        "react-pageflip": "^2.0.3",
        "sonner": "^2.0.7",
        "tailwind-merge": "^3.5.0",
        "ziggy-js": "^2.6.2"
    }
